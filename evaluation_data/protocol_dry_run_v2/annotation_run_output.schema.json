{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["case_id", "annotator_id", "annotation_status", "source", "findings", "missing_context_requests", "review_summary"],
  "properties": {
    "case_id": {"type": "string"}, "annotator_id": {"type": "string"},
    "annotation_status": {"enum": ["COMPLETE", "NEEDS_MORE_CONTEXT"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["base_sha", "head_sha", "repository_access_mode"], "properties": {"base_sha": {"type": "string"}, "head_sha": {"type": "string"}, "repository_access_mode": {"const": "FROZEN_REPOSITORY_READ_ONLY", "type": "string"}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["annotation_finding_id", "issue_exists", "should_comment", "category", "cwe", "path", "start_line", "end_line", "severity", "evidence_refs", "technical_rationale", "comment_usefulness_rationale"], "properties": {
      "annotation_finding_id": {"type": "string"}, "issue_exists": {"const": true, "type": "boolean"}, "should_comment": {"type": "boolean"}, "category": {"type": "string"}, "cwe": {"type": ["string", "null"]}, "path": {"type": "string"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "severity": {"enum": ["low", "medium", "high", "critical"]},
      "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "start_line", "end_line", "revision", "description"], "properties": {"path": {"type": "string"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "revision": {"type": "string"}, "description": {"type": "string"}}}},
      "technical_rationale": {"type": "string"}, "comment_usefulness_rationale": {"type": "string"}
    }}},
    "missing_context_requests": {"type": "array", "items": {"type": "string"}}, "review_summary": {"type": "string"}
  }
}
