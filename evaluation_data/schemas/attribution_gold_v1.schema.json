{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoagent.local/schemas/attribution-gold-v1.json",
  "title": "EvoAgent Evidence-Adjudicated Attribution Gold v1",
  "type": "object",
  "required": [
    "schema_version", "failure_id", "task_id", "release_id", "review_revision",
    "observable_failure_layer", "status", "supported_surface", "target_skill",
    "evidence_refs", "rationale", "annotation_status", "annotators", "reviewer_labels",
    "gold_evidence_level", "objective_evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "failure_id": {"type": ["string", "integer"]},
    "task_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "review_revision": {"type": "string", "minLength": 1},
    "observable_failure_layer": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUPPORTED", "INSUFFICIENT_EVIDENCE", "UNKNOWN"]},
    "supported_surface": {"enum": ["GLOBAL_PROMPT", "SKILL", "NO_SUPPORTED_EVOLUTION"]},
    "target_skill": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "rationale": {"type": "string", "minLength": 1},
    "annotation_status": {"enum": ["ADJUDICATED", "QUARANTINED", "NEEDS_MORE_CONTEXT"]},
    "gold_evidence_level": {"enum": ["OBJECTIVE", "INDEPENDENT_MODEL_AGREEMENT", "MODEL_ADJUDICATED", "HUMAN_ADJUDICATED", "QUARANTINED"]},
    "objective_evidence": {"type": ["array", "null"]},
    "annotators": {"type": "array", "minItems": 1},
    "reviewer_labels": {"type": "array"},
    "adjudication": {"type": ["object", "null"]},
    "uncertainty_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
