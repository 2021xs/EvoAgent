{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoagent.local/schemas/evidence-adjudicated-benchmark-case-v2.json",
  "title": "EvoAgent Evidence-Adjudicated Benchmark Case v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_version", "annotation_version", "case_id", "repository_id", "source", "base_sha", "head_sha", "diff_sha256", "captured_at", "split", "diff", "annotators", "findings", "case_annotation_status", "reviewer_records", "clean_review"],
  "properties": {
    "schema_version": {"const": 2}, "dataset_id": {"type": "string", "minLength": 1}, "dataset_version": {"type": "string", "minLength": 1}, "annotation_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["kind", "reference_id"], "properties": {"kind": {"enum": ["public-github-pr", "private-historical-pr"]}, "reference_id": {"type": "string", "minLength": 1}, "url": {"type": ["string", "null"]}}, "additionalProperties": true},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}, "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}, "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "captured_at": {"type": "string", "format": "date-time"},
    "split": {"enum": ["evolution_feedback", "validation", "operational_gating", "final_holdout", "protocol_dry_run"]}, "diff": {"type": "string", "minLength": 1}, "protocol_dry_run": {"type": "boolean", "default": false}, "final_claim_eligible": {"type": "boolean", "const": false},
    "related_cases": {"type": "array", "items": {"type": "object", "required": ["case_id", "relationship"], "properties": {"case_id": {"type": "string", "minLength": 1}, "relationship": {"enum": ["backport", "cherry-pick", "revert", "forked-duplicate", "patch-series"]}}, "additionalProperties": false}},
    "annotators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/annotator"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "case_annotation_status": {"enum": ["ADJUDICATED", "QUARANTINED", "NEEDS_MORE_CONTEXT"]}, "reviewer_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reviewerRecord"}}, "clean_review": {"$ref": "#/$defs/cleanReview"}
  },
  "$defs": {
    "blindness": {"type": "object", "additionalProperties": false, "required": ["evoagent_prediction_visible", "experiment_arm_visible", "peer_annotation_visible", "production_attribution_visible"], "properties": {"evoagent_prediction_visible": {"type": "boolean"}, "experiment_arm_visible": {"type": "boolean"}, "peer_annotation_visible": {"type": "boolean"}, "production_attribution_visible": {"type": "boolean"}}},
    "annotator": {"type": "object", "additionalProperties": false, "required": ["annotator_id", "annotator_kind", "role", "provider", "model", "model_revision", "prompt_version", "prompt_hash", "context_policy_id", "context_policy_hash", "tool_policy_id", "tool_policy_hash", "repository_access_mode", "run_id", "started_at", "completed_at", "blindness"], "properties": {
      "annotator_id": {"type": "string", "minLength": 1}, "annotator_kind": {"enum": ["MODEL", "HUMAN", "OBJECTIVE_EVIDENCE"]}, "role": {"enum": ["FIRST_PASS", "ADJUDICATOR", "OBJECTIVE_EVIDENCE"]},
      "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "model_revision": {"type": ["string", "null"]}, "prompt_version": {"type": ["string", "null"]}, "prompt_hash": {"type": ["string", "null"]}, "context_policy_id": {"type": ["string", "null"]}, "context_policy_hash": {"type": ["string", "null"]}, "tool_policy_id": {"type": ["string", "null"]}, "tool_policy_hash": {"type": ["string", "null"]},
      "repository_access_mode": {"enum": ["FROZEN_DIFF_ONLY", "FROZEN_REPOSITORY_READ_ONLY", "OBJECTIVE_RUNTIME_EVIDENCE"]}, "run_id": {"type": "string", "minLength": 1}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "blindness": {"$ref": "#/$defs/blindness"}
    }},
    "reviewerLabel": {"type": "object", "additionalProperties": true, "required": ["annotator_id", "issue_exists", "should_comment", "logical_issue_id", "category", "path", "start_line", "end_line", "severity", "evidence_refs", "rationale", "duration_seconds", "submitted_at"], "properties": {"annotator_id": {"type": "string"}, "issue_exists": {"type": "boolean"}, "should_comment": {"type": "boolean"}, "logical_issue_id": {"type": ["string", "null"]}, "category": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}, "start_line": {"type": ["integer", "null"]}, "end_line": {"type": ["integer", "null"]}, "severity": {"type": ["string", "null"]}, "evidence_refs": {"type": "array"}, "rationale": {"type": "string", "minLength": 1}, "duration_seconds": {"type": "number", "minimum": 0}, "submitted_at": {"type": "string", "format": "date-time"}}},
    "objectiveEvidence": {"type": "object", "additionalProperties": true, "required": ["evidence_kind", "source_revision", "evidence_refs", "rationale", "scope"], "properties": {"evidence_kind": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1}, "rationale": {"type": "string", "minLength": 1}, "coverage_rationale": {"type": ["string", "null"]}, "scope": {"type": "array", "minItems": 1, "items": {"enum": ["FINDING_EXISTENCE", "FINDING_BEHAVIOR", "LOCATION", "SEVERITY", "WHOLE_CASE_CLEAN", "OBSERVABLE_FAILURE_LAYER", "EVOLUTION_ROUTE"]}}}},
    "finding": {"type": "object", "additionalProperties": true, "required": ["issue_id", "category", "path", "start_line", "end_line", "severity", "issue_exists", "should_comment", "technical_evidence", "technical_rationale", "comment_usefulness_rationale", "annotation_status", "reviewer_labels", "gold_evidence_level", "objective_evidence"], "properties": {"issue_id": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "rule_id": {"type": ["string", "null"]}, "cwe": {"type": ["string", "null"]}, "path": {"type": "string", "minLength": 1}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "severity": {"enum": ["low", "medium", "high", "critical"]}, "issue_exists": {"type": "boolean"}, "should_comment": {"type": "boolean"}, "technical_evidence": {"type": "array", "items": {"type": "string"}}, "technical_rationale": {"type": "string", "minLength": 1}, "comment_usefulness_rationale": {"type": "string", "minLength": 1}, "annotation_status": {"enum": ["ADJUDICATED", "QUARANTINED", "NEEDS_MORE_CONTEXT"]}, "gold_evidence_level": {"enum": ["OBJECTIVE", "INDEPENDENT_MODEL_AGREEMENT", "MODEL_ADJUDICATED", "HUMAN_ADJUDICATED", "QUARANTINED"]}, "objective_evidence": {"type": ["array", "null"], "items": {"$ref": "#/$defs/objectiveEvidence"}}, "reviewer_labels": {"type": "array", "items": {"$ref": "#/$defs/reviewerLabel"}}, "adjudication": {"type": ["object", "null"]}, "uncertainty_reason": {"type": ["string", "null"]}}},
    "reviewerRecord": {"type": "object", "additionalProperties": true, "required": ["annotator_id", "completed_review", "duration_seconds", "submitted_at"], "properties": {"annotator_id": {"type": "string"}, "completed_review": {"const": true}, "duration_seconds": {"type": "number", "minimum": 0}, "submitted_at": {"type": "string", "format": "date-time"}}},
    "cleanReview": {"type": "object", "additionalProperties": true, "required": ["completed", "no_commentable_findings_remain", "rationale", "gold_evidence_level", "objective_evidence"], "properties": {"completed": {"type": "boolean"}, "no_commentable_findings_remain": {"type": "boolean"}, "rationale": {"type": "string"}, "gold_evidence_level": {"enum": ["OBJECTIVE", "INDEPENDENT_MODEL_AGREEMENT", "MODEL_ADJUDICATED", "HUMAN_ADJUDICATED", "QUARANTINED"]}, "objective_evidence": {"type": ["array", "null"], "items": {"$ref": "#/$defs/objectiveEvidence"}}, "adjudication": {"type": ["object", "null"]}}}
  }
}
