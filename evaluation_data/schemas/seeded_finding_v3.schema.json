{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoagent.local/schemas/seeded_finding_v3.schema.json",
  "title": "SeededFinding v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "methodology_version", "seed_id", "case_id", "repository_id", "base_sha", "head_sha", "issue_identity", "location", "severity", "should_comment", "technical_proposition", "evidence", "qualification_status", "verification_provenance", "rationale"],
  "properties": {
    "schema_version": {"const": 3},
    "methodology_version": {"const": "open-world-final-v3"},
    "seed_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "issue_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "rule_id", "cwe"],
      "properties": {
        "category": {"type": ["string", "null"]},
        "rule_id": {"type": ["string", "null"]},
        "cwe": {"type": ["string", "null"]}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "supportable"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "supportable": {"type": "boolean"}
      }
    },
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "should_comment": {"type": "boolean"},
    "technical_proposition": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_type", "evidence_refs", "source_revision", "benchmark_construction_only", "supported_proposition"],
        "properties": {
          "evidence_type": {"enum": ["REGRESSION_TEST", "REPRODUCER", "FIX_COMMIT_WITH_MATCHING_EVIDENCE", "ISSUE_PLUS_VERIFIED_FIX", "SECURITY_ADVISORY", "DETERMINISTIC_RUNTIME_FAILURE", "OTHER_EXPLICITLY_VERIFIED_OBJECTIVE_EVIDENCE"]},
          "evidence_refs": {"type": "array", "minItems": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "benchmark_construction_only": {"const": true},
          "supported_proposition": {"type": "string", "minLength": 1}
        }
      }
    },
    "qualification_status": {"enum": ["QUALIFIED", "REJECTED", "NEEDS_MORE_CONTEXT", "QUARANTINED"]},
    "verification_provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["verifier_id", "verifier_kind", "run_id", "outcome", "evoagent_prediction_visible", "experiment_arm_visible", "repository_access_mode", "rationale"],
      "properties": {
        "verifier_id": {"type": "string", "minLength": 1},
        "verifier_kind": {"enum": ["MODEL", "HUMAN", "OBJECTIVE_EVIDENCE"]},
        "run_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["QUALIFIED", "REJECTED", "NEEDS_MORE_CONTEXT", "QUARANTINED"]},
        "evoagent_prediction_visible": {"const": false},
        "experiment_arm_visible": {"const": false},
        "repository_access_mode": {"const": "FROZEN_REPOSITORY_READ_ONLY"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "rationale": {"type": "string", "minLength": 1}
  }
}
